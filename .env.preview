# -------------------------------------------
#                                           |
#           针对【预览】环境的配置            |
#                                           |
# -------------------------------------------
# 预览态：用生产构建产物 + mock 服务，
# 不依赖任何后端。mock 由 vite preview 服务端中间件接管，
# 因此仅 `pnpm preview` 本地生效，产物直接托管到 nginx 不会带 mock。

# 接口前缀，axios 与 mock 共用
VITE_APP_BASE_API=/api/v1

# 接口的网关地址
# preview 服务不转发接口，未被 mock 命中的请求才会走到这里，作兜底
VITE_APP_API_URL=http://localhost:9420

# websocket 代理地址
# mock 不接管 ws，此处连不上不影响 HTTP 接口
VITE_APP_WS_ENDPOINT=ws://localhost:9420/api/v1/websocket

# 音乐服务地址
VITE_APP_MUSIC_API_URL=http://localhost:9420/api/v1/music

# ai助手服务地址
VITE_APP_AI_API_URL=http://localhost:9420/api/v1/ai

# 本地存储前缀
VITE_STORAGE_PREFIX=blog-preview

# 开发态 mock 服务开关
VITE_MOCK_DEV_SERVER=true
