{
  "name": "blog-app",
  "version": "4.0.0",
  "description": "分享个人学习记录的个人博客",
  "keywords": [
    "个人博客",
    "前端",
    "全栈",
    "vue3",
    "vite",
    "typescript",
    "naive-ui"
  ],
  "author": "791422171@qq.com",
  "license": "MIT",
  "repository": "https://github.com/ve-weiyi/blog-app.git",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode development --host",
    "test": "vite --mode test --host",
    "prod": "vite --mode production --host",
    "build": "vue-tsc --noEmit && vite --mode production build",
    "build:preview": "vue-tsc --noEmit && vite --mode preview build",
    "build:dev": "vue-tsc --noEmit && vite --mode development build",
    "preview": "vite preview --mode preview --host",
    "type-check": "vue-tsc --noEmit",
    "format": "prettier --write src",
    "mirror:get": "pnpm config get registry",
    "mirror:set": "pnpm config set registry https://registry.pnpmmirror.com",
    "mirror:rm": "pnpm config rm registry",
    "backup": "git add . && git commit -m \"chore: backup\" && git push",
    "up": "npx pnpm-check-updates -u",
    "prepare": "",
    "depcheck": "pnpm exec depcheck",
    "lint-fix": "eslint --fix --ext .js,.ts,.jsx,.tsx,.vue src",
    "lint-prettier": "prettier --write  \"src/**/*.{js,json,tsx,css,less,scss,vue,html,md}\"",
    "lint": "pnpm run lint-prettier && pnpm run lint-fix"
  },
  "dependencies": {
    "@kangc/v-md-editor": "^2.3.18",
    "@stomp/stompjs": "^7.3.0",
    "@types/qs": "^6.15.1",
    "@vueuse/core": "^14.4.0",
    "aplayer": "^1.10.1",
    "axios": "^1.20.0",
    "crypto-js": "^4.2.0",
    "easy-typer-js": "^2.1.0",
    "echarts": "^6.1.0",
    "lodash-es": "^4.18.1",
    "naive-ui": "^2.45.3",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "prismjs": "^1.30.0",
    "qs": "^6.16.0",
    "swiper": "^14.2.0",
    "tocbot": "^4.36.8",
    "v-viewer": "^3.0.23",
    "viewerjs": "^1.14.0",
    "vue": "^3.5.42",
    "vue-cropper": "^1.1.4",
    "vue-masonry": "^0.16.0",
    "vue-router": "^5.3.1",
    "vue3-danmaku": "^1.6.7",
    "vue3-lazy": "1.0.0-alpha.1",
    "vue3-social-share": "^0.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.5.1",
    "@types/nprogress": "^0.2.3",
    "@types/prismjs": "^1.26.6",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "sass": "^1.104.1",
    "typescript": "^5.9.3",
    "unocss": "^66.10.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^24.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.0",
    "vite-plugin-banner": "^0.8.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-mock-dev-server": "^2.4.2",
    "vite-plugin-prismjs": "^0.0.11",
    "vite-plugin-progress": "^0.0.7",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=8.15.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged --concurrent false"
  },
  "lint-staged": {
    "*.{js,jsx,vue,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
